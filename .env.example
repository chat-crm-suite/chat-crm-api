# Desarrollo: copiar a .env y rellenar los secretos con
#   ./deploy/gen-secrets.sh --env .env
# Solo las variables necesarias. Opcionales (con valor por defecto): ver AGENTS.md.

# Base de datos (la API)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=
DB_DATABASE=chat_crm_db

# Espejo para la imagen mysql:8.0 (el compose usa UN SOLO env_file): mismos
# valores que DB_*. MYSQL_USER no puede ser root.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat_crm_db
MYSQL_USER=nestjs_user
MYSQL_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=

# Origen del front (CORS)
CORS_ORIGIN=http://localhost:5173

# AES-256-GCM para las credenciales de los canales (64 hex o base64 de 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=

# App Secret de Meta (Meta Dashboard → tu app → App settings → App Secret).
# El webhook de WhatsApp verifica la firma X-Hub-Signature-256 con este valor:
# sin él (o con firma inválida) los POST entrantes responden 403.
WHATSAPP_APP_SECRET=

# Token del primer arranque: la pantalla de configuración inicial lo pide.
# En desarrollo puede quedar vacío (no lo pide); en producción lo genera el script.
SETUP_TOKEN=
