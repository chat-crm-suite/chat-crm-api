# Database configuration
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_DATABASE=chat_crm_db

# Espejos para la imagen mysql:8.0 (el compose global usa UN SOLO env_file,
# así que deben repetirse aquí con LOS MISMOS valores de arriba).
# Mismo patrón que .env.prod.example.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=chat_crm_db
MYSQL_USER=nestjs_user
MYSQL_PASSWORD=change_me

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
# Vacío = sin auth (solo desarrollo local sin password)
# REDIS_PASSWORD=

# Environment
NODE_ENV=development
PORT=3000

# JWT (genera uno propio: openssl rand -hex 32)
JWT_SECRET=change_me_jwt_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookie: 1 en producción HTTPS, 0 solo desarrollo local HTTP
COOKIE_SECURE=0

# Bootstrap: crea el primer admin SOLO si la tabla users está vacía.
# Dejar vacío tras el primer arranque (o definir siempre: es idempotente).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Bootstrap headless (opcional): si se define, crea la primera empresa + member
# admin (y la config de WhatsApp si las WHATSAPP_* están completas) cuando el
# setup aún no está inicializado. Idempotente.
BOOTSTRAP_COMPANY_NAME=

# Token del primer arranque (recomendado en producción). Si se define, POST /setup
# exige este valor; si no se define en producción, la API genera uno al azar y lo
# registra una sola vez en los logs. Vacío en dev = /setup no pide token.
SETUP_TOKEN=

# Swagger / OpenAPI document: served at /docs (+ /docs-json). Enabled by default
# outside production; set to false to disable or true to force it in production.
SWAGGER_ENABLED=

# AI
IA_URL=http://chat-crm-ia:8000

# Whatsapp (no commitear valores reales, solo placeholders)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_me
# Necesarias solo para el bootstrap headless de WhatsApp (Settings usa la UI).
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_VERSION=

# AES-256-GCM key for channel credentials (64 hex chars or base64 of 32 bytes)
CREDENTIALS_ENCRYPTION_KEY=
