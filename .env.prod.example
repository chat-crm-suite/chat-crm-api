# .env.prod — PLANTILLA para el servidor. NO commitear valores reales.
# Copiar en servidor a .env.prod y rellenar con secretos (openssl rand -hex 32).
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=CHANGE_ME_segura_32_chars
DB_ROOT_PASSWORD=CHANGE_ME_root_segura_32_chars
DB_DATABASE=chat_crm_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_segura

NODE_ENV=production
PORT=3000

JWT_SECRET=CHANGE_ME_generar_con_openssl_rand_hex_32

# En prod: origen público del front (sin trailing slash)
# Servidor empresa: http://<TU_DOMINIO_O_IP>:<PUERTO_FRONT>
CORS_ORIGIN=http://<TU_DOMINIO_O_IP>:<PUERTO_FRONT>
COOKIE_SECURE=0
# Si hay HTTPS con reverse proxy -> COOKIE_SECURE=1

# Bootstrap: crea el primer admin SOLO si la tabla users está vacía
# (generar password: openssl rand -hex 16). Idempotente: con users poblada no hace nada.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_8_chars

# Espejos para la imagen mysql:8.0 (el compose global solo usa env_file,
# así que deben repetirse aquí con LOS MISMOS valores de arriba)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_segura_32_chars
MYSQL_DATABASE=chat_crm_db
MYSQL_USER=nestjs_user
MYSQL_PASSWORD=CHANGE_ME_segura_32_chars

# IA en la misma red crm-network (nombre del servicio en compose)
IA_URL=http://chat-crm-ia:8000

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME

# AES-256-GCM key for channel credentials (64 hex chars or base64 of 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
