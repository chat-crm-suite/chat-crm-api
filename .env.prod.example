# .env.prod — PLANTILLA para el servidor. NO commitear valores reales.
# En el servidor: copiar a .env.prod y rellenar los secretos con
#   ./deploy/gen-secrets.sh
# Solo las variables necesarias. Opcionales (con valor por defecto): ver AGENTS.md.

# Base de datos (la API)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nestjs_user
DB_PASSWORD=
DB_DATABASE=chat_crm_db

# Espejo para la imagen mysql:8.0 (el compose global usa UN SOLO env_file): mismos
# valores que DB_*. MYSQL_USER no puede ser root (si DB_USERNAME=root, borra
# MYSQL_USER y MYSQL_PASSWORD y la API usa MYSQL_ROOT_PASSWORD).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat_crm_db
MYSQL_USER=nestjs_user
MYSQL_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=

# Origen público del front (sin barra final). Con HTTPS añade COOKIE_SECURE=1.
CORS_ORIGIN=http://<TU_DOMINIO_O_IP>:<PUERTO_FRONT>

# AES-256-GCM para las credenciales de los canales (64 hex o base64 de 32 bytes).
# Si se pierde, los tokens de WhatsApp guardados no se pueden descifrar.
CREDENTIALS_ENCRYPTION_KEY=
