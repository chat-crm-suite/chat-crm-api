{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@contracts": [
        "./src/contracts/index"
      ],
      "@contracts/*": [
        "./src/contracts/*"
      ],
      "@config": [
        "./src/config/index"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@strategies/*": [
        "./src/strategies/*"
      ],
      "@docs/*": [
        "./src/docs/*"
      ],
      "@scripts/*": [
        "./src/scripts/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@auth": [
        "./src/auth/index"
      ],
      "@auth/*": [
        "./src/auth/*"
      ],
      "@entities": [
        "./src/entities/index"
      ],
      "@modules": [
        "./src/modules/index"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@factories": [
        "./test/factories/index"
      ],
      "@helpers/*": [
        "./test/helpers/*"
      ],
      "@integrations/*": [
        "./src/integrations/*"
      ],
      "@core/*": [
        "./src/core/*"
      ]
    }
  }
}